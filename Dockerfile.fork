# The same image as Dockerfile, built from the vLLM fork branch instead of applying patches/.
#
# vLLM's own wheel supplies the compiled libraries and the Rust frontend (VLLM_USE_PRECOMPILED); the
# Python tree comes from the fork branch, which is the patch series as commits on the release tag
# (see PATCHES.md and docs/vllm-0.31.md). The two routes produce byte-identical Python trees; this one
# ports to a new pin with `git rebase` and carries authorship. Nothing in patches/ or kvarn/ is applied
# here; verify.sh still checks every patch is present in the installed tree, because the content is.
#
#   docker build -f Dockerfile.fork -t qwen38-27b-rtx3090:fork-0.31 .
#   docker build -f Dockerfile.fork --build-arg VLLM_FORK_COMMIT=<sha> .
FROM nvidia/cuda:13.0.3-base-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.12 python3.12-venv python3.12-dev \
      cuda-nvcc-13-0 cuda-cudart-dev-13-0 libcurand-dev-13-0 \
      build-essential patch curl ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN python3.12 -m venv venv && venv/bin/pip install --upgrade pip
COPY docker/requirements.txt docker/requirements.txt
# The release wheel and its dependency set, exactly as the patch route installs them.
RUN venv/bin/pip install -r docker/requirements.txt

# The optional op libraries, built against the release wheel exactly as Dockerfile builds them, ahead of the
# fork layer so a pin move does not recompile them: pth-flash-attn (pthfa/, PTH_FA=1) and the fp8-KV FA2 port
# (fa2/, FA2_FP8KV=1; git, already installed above, fetches CUTLASS into a /tmp the same layer removes).
COPY pthfa/ pthfa/
RUN PY=venv/bin/python bash pthfa/install.sh
COPY fa2/ fa2/
RUN FA2_CACHE=/tmp/fa2-cache bash fa2/install.sh && rm -rf /tmp/fa2-cache
# xgrammar from source (mlc-ai/xgrammar#989 and the Qwen framing fix), as Dockerfile builds it.
COPY xgrammar/ xgrammar/
RUN bash xgrammar/install.sh

# The fork: pinned by commit, built as a wheel over the release wheel's compiled parts.
ARG VLLM_FORK_REPO=https://github.com/cpuchip/vllm
ARG VLLM_FORK_COMMIT=33e35f268d813de931265f097224c4f344aa06d7
ARG VLLM_VERSION=0.32.0
RUN set -e; \
    venv/bin/pip install "setuptools>=77" setuptools_scm setuptools-rust wheel; \
    venv/bin/pip download "vllm==${VLLM_VERSION}" --no-deps -d /tmp/wheel; \
    git clone --filter=blob:none "$VLLM_FORK_REPO" /tmp/vllm-src; \
    git -C /tmp/vllm-src checkout -q "$VLLM_FORK_COMMIT"; \
    export VLLM_USE_PRECOMPILED=1 VLLM_PRECOMPILED_WHEEL_LOCATION="$(ls /tmp/wheel/vllm-${VLLM_VERSION}-*.whl)"; \
    export SETUPTOOLS_SCM_PRETEND_VERSION_FOR_VLLM="$VLLM_VERSION" SETUPTOOLS_SCM_PRETEND_VERSION="$VLLM_VERSION"; \
    venv/bin/pip wheel --no-deps --no-build-isolation -w /tmp/out /tmp/vllm-src; \
    SP=$(venv/bin/python -c 'import vllm, os; print(os.path.dirname(vllm.__file__))' | tail -n1); \
    venv/bin/pip uninstall -y vllm; rm -rf "$SP" "$(dirname "$SP")"/vllm-*.dist-info; \
    venv/bin/pip install --no-deps /tmp/out/vllm-*.whl; \
    echo "vllm fork $VLLM_FORK_COMMIT installed as $(venv/bin/python -c 'import vllm; print(vllm.__version__)')"; \
    rm -rf /tmp/vllm-src /tmp/wheel /tmp/out

COPY . .
# bench/mq3d_scratch_pool_test.py imports the patched triton_attn.py and runs on CPU tensors, as in Dockerfile.
# The same post-install tests Dockerfile runs after applying the series.
RUN set -e; bash verify.sh --install; \n    venv/bin/python bench/test_dflash_context_capacity.py; \n    venv/bin/python bench/mq3d_scratch_pool_test.py; \n    venv/bin/python bench/test_quant_scale_views.py; \n    CUDA_VISIBLE_DEVICES= venv/bin/python pthfa/tests/gate_test.py; \n    venv/bin/python fa2/tests/gate_test.py; \n    venv/bin/python fa2/tests/check_mixed_prefill.py --device cpu; \n    CUDA_VISIBLE_DEVICES= venv/bin/python bench/test_async_mamba_kv_sizing.py; \n    CUDA_VISIBLE_DEVICES= venv/bin/python bench/test_kv_cache_seat_budget.py; \n    CUDA_VISIBLE_DEVICES= venv/bin/python bench/test_continuous_stream_usage.py; \n    venv/bin/python bench/test_gdn_ba_lora.py

# HOME is a volume: torch.compile cache (~/.cache/vllm), Triton (~/.triton),
# FlashInfer JIT (~/.cache/flashinfer), HF hub cache.
RUN mkdir -p /cache /app/models && chmod 1777 /cache
ENV HOME=/cache VLLM_NO_USAGE_STATS=1 DO_NOT_TRACK=1 HF_XET_HIGH_PERFORMANCE=1
VOLUME ["/cache", "/app/models"]
EXPOSE 18020
ENTRYPOINT ["bash", "docker/entrypoint.sh"]
CMD ["single"]
