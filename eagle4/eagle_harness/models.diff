+    def _int8_lm_head(self) -> None:
+        """[local mod] lm_head.weight as int8 [V, H] with lm_head.weight_scale fp32 [V] (per-row symmetric);
+        gather_dot reads the scale from ``weight.row_scale``."""
+        head = self.lm_head
+        w = head.weight
+        q = nn.Parameter(torch.empty(w.shape, dtype=torch.int8, device=w.device), requires_grad=False)
+        q.__dict__.update(w.__dict__)
+        s = nn.Parameter(torch.empty(w.shape[0], dtype=torch.float32, device=w.device), requires_grad=False)
+        s.output_dim = 0
+        s.weight_loader = head.weight_loader
+        del head.weight
+        head.register_parameter("weight", q)
+        head.register_parameter("weight_scale", s)
+        q.row_scale = s
+        del w
+        torch.cuda.empty_cache()
+
